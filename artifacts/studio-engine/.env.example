# ── InDesign AI engine (studio-engine) ──────────────────────────────────────
# Copiá este archivo a .env (local) o cargá estas variables como Secrets en Replit.

# Puerto del motor.
ENGINE_PORT=8790

# Llave de OpenAI. En Replit usar Secrets. Sin esto, /engine/key-status reporta hasKey=false
# y la generación (corridas siguientes) queda deshabilitada.
OPENAI_API_KEY=

# Almacenamiento de estado/salidas: "file" (por ahora) | "pg" (corrida 15, Postgres).
STORE=file

# Modelos.
ENGINE_TEXT_MODEL=gpt-4o-mini
ENGINE_IMAGE_MODEL=gpt-image-1
ENGINE_IMAGE_QUALITY=medium
ENGINE_IMAGE_SIZE=1536x1024
ENGINE_IMAGE_MAX_ATTEMPTS=3

# Guardrail de costo (USD): costo estimado por imagen y tope mensual (0 = sin tope).
ENGINE_IMAGE_COST_USD=0.04
ENGINE_COST_CAP_USD=25

# Opcional: raíz de salidas. Por defecto escribe en
# artifacts/studio/public/assets/cloudbooks-engine (namespace separado de Codex),
# para que Vite las sirva en /assets/cloudbooks-engine/...
# ENGINE_OUTPUT_ROOT=
