# ── studio-engine — motor editorial (la FABRICA de libros) ───────────────────
# Copia este archivo a `.env` (local). El engine NO se despliega: corre en tu
# maquina. Por eso ninguna de estas claves viaja al deploy de la tienda.
#
# Arranque (ver CLAUDE.md): desde ESTE directorio,
#   node --env-file=.env --import tsx src/index.ts
# No uses `npm run start`: deja un hijo node sirviendo codigo viejo.
#
# Los valores de abajo son los DEFAULTS reales del codigo (src/config.ts).
# Todo esta comentado salvo lo que de verdad hay que completar.

# ── Red ──────────────────────────────────────────────────────────────────────
# ENGINE_PORT=8790
# Bind. Por defecto SOLO localhost. 0.0.0.0 expone a la LAN: hacelo unicamente
# con firewall Y con ENGINE_TOKEN seteado.
# ENGINE_HOST=127.0.0.1
# Token de escritura. Si esta vacio NO HAY AUTENTICACION (hoy es opt-in) y, aun
# seteado, los GET siguen exentos. Solo protege mientras el engine sea local.
# ENGINE_TOKEN=

# ── Claves de proveedores (OBLIGATORIO para generar) ─────────────────────────
# Sin esto el motor arranca pero no genera nada.
OPENAI_API_KEY=

# Kimi/Moonshot: se usa para el agente AUTOR si se rutea por modelo.
# ENGINE_KIMI_KEY=
# ENGINE_KIMI_BASE_URL=https://api.moonshot.ai/v1
# ENGINE_KIMI_EFFORT=low

# Azure para IMAGEN: si estas tres estan seteadas, TODA la generacion de imagen
# va al deployment de Azure (el texto sigue en OpenAI/Kimi). El endpoint debe
# terminar en /openai/v1.
# ENGINE_AZURE_IMAGE_ENDPOINT=
# ENGINE_AZURE_IMAGE_KEY=
# ENGINE_AZURE_IMAGE_MODEL=

# ── Rutas ────────────────────────────────────────────────────────────────────
# Working root: TODA la salida del motor (~1.4 GB). Si es RELATIVO se resuelve
# contra la raiz de ESTE paquete, no contra el cwd.
# ENGINE_OUTPUT_ROOT=../../.data/engine
# Raiz PUBLICADA: el subconjunto que sirve la tienda, que materializa
# POST /engine/publish-assets espejando las rutas relativas.
# ENGINE_PUBLISH_ROOT=../../artifacts/studio/public/assets/cloudbooks-engine
# Chrome/Edge para render y PDF. Si no se encuentra, el ensamblado falla con
# "Sin Chrome headless" (puppeteer-core NO trae navegador).
# ENGINE_CHROME_PATH=

# ── Modelos (ruteo por agente) ───────────────────────────────────────────────
# ENGINE_TEXT_MODEL=gpt-5.6-luna
# ENGINE_QA_MODEL=gpt-5.6-luna
# ENGINE_AUTHOR_MODEL=gpt-5.6-luna
# ENGINE_ENRICH_MODEL=gpt-5.6-luna
# Escalada del enriquecedor cuando el gate bloquea (vacio = no escala).
# ENGINE_ENRICH_ESCALATE_MODEL=
# ENGINE_PRACTICE_VERIFY_MODEL=gpt-5.6-terra
# Vision: es el Inspector que audita cada lamina generada.
# ENGINE_VISION_MODEL=gpt-4.1-mini
# ENGINE_IMAGE_MODEL=gpt-image-2

# ── Imagen ───────────────────────────────────────────────────────────────────
# ENGINE_IMAGE_QUALITY=medium
# ENGINE_IMAGE_SIZE=1536x1024
# ENGINE_IMAGE_MAX_ATTEMPTS=3
# Laminas del Visual Atlas (vertical).
# ENGINE_INFOGRAPHIC_SIZE=1024x1536
# ENGINE_INFOGRAPHIC_QUALITY=medium
# ENGINE_INFOGRAPHIC_REROLLS=2
# Master de estilo: la lamina aprobada como ancla del look, por cert+formato.
# ENGINE_STYLE_ANCHOR=true
# ENGINE_ALWAYS_VARIANTS=true

# ── Guardrails de costo ──────────────────────────────────────────────────────
# OJO: son ESTIMACIONES internas para el ledger, NO el saldo real del proveedor.
# Antes de una tanda grande, verifica el saldo REAL en OpenAI/Azure.
# ENGINE_IMAGE_COST_USD=0.04
# ENGINE_INFOGRAPHIC_COST_USD=0.07
# Tope mensual estimado en USD (0 = sin tope).
# ENGINE_COST_CAP_USD=25
# Gatea la generacion de imagen cuando el riesgo evaluado es alto.
# ENGINE_GATE_ON_RISK=true

# ── Otros ────────────────────────────────────────────────────────────────────
# Backend de estado. "pg" es un ENUM SIN IMPLEMENTACION: no hay una linea de
# Postgres en el engine. Dejar en "file".
# STORE=file
# Stores namespaceados por cert+formato. "off" vuelve al store global legacy.
# ENGINE_PERCERT_STORES=on
# Umbral de unidad densa: con esta cantidad de tarjetas la lamina pasa a SPREAD.
# ENGINE_SPREAD_MIN_MODULES=7
# Gate de grounding.
# GROUNDING_GATE=
