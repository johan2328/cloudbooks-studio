# ── studio — frontend React+Vite (tienda publica + cockpit interno) ──────────
# Copia a `.env` para desarrollo local.
#
# OJO: PORT y BASE_PATH son OBLIGATORIAS. `vite.config.ts` lanza una excepcion
# si falta cualquiera de las dos, asi que sin ellas ni el dev server ni el build
# arrancan. En Replit ya vienen definidas en .replit-artifact/artifact.toml.

# Puerto del dev server (Vite). Obligatorio.
PORT=5173

# Base publica de la app. Obligatorio. Casi siempre "/".
# En Git Bash exportarlo puede mangle la barra: en Windows usar PowerShell.
BASE_PATH=/

# ── Opcionales ───────────────────────────────────────────────────────────────
# Host del dev server. Por defecto SOLO localhost; 0.0.0.0 lo expone a la LAN.
# VITE_HOST=localhost

# Motor de libros. Solo aplica en DESARROLLO: el proxy /engine de Vite vive en
# `server.proxy`, asi que en produccion no existe y la tienda cae a la ficha
# publicada estatica (src/lib/published-book.ts).
# ENGINE_URL=http://127.0.0.1:8790

# Token del engine. Lo inyecta el proxy de Vite del lado del SERVIDOR, asi que
# NO entra al bundle del navegador. No le pongas prefijo VITE_.
# ENGINE_TOKEN=

# Working root del engine, para que el dev server sirva tambien las paginas
# intermedias (no solo lo publicado). Por defecto <repo>/.data/engine.
# ENGINE_WORKING_ROOT=
